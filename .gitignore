# ── Assembled at runtime by assemble.ps1 — never committed ─────────────
# These come from their own repos / release zips; keeping them out of this
# repo avoids drift and keeps the kit small. Run `pwsh assemble.ps1` to fill.
/assembled/

# ── Tooling junk ───────────────────────────────────────────────────────
node_modules/
*.log
.DS_Store
Thumbs.db
/tools/measure/out/
*.tmp
/tools/measure/parity/

# Conversion outputs (screenshots/bundles/state) — kit-local, regenerable
/capture-out/
/capture-out-v2/
/capture-fresh/
/logs/

# Launcher once-a-day auto-update markers (local only; never shipped)
.last-update-check
.no-auto-update

# Local-only training extractor (contains source-site brand content — never ship)
/tools/training/

# Converter-trainer corpus that names real captured source sites -- NEVER ship.
# corpus-01.txt is keyed by neutral abstract slugs and is fine; corpus-02 lists
# the actual URLs that were converted, which must not appear in any artifact.
/tools/converter-trainer/sites/corpus-02.txt
/tools/converter-trainer/capture-out/

# Stray capture artifacts from measure runs (regenerable, never shipped)
/tools/measure/shot.png
/tools/measure/undefined/
